{
  "expo": {
    "name": "AMIP TM",
    "slug": "amiptm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.argilatecnologia.amiptm"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F243F"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "br.com.argilatecnologia.amiptm"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "A aplicação acessa sua galeria de fotos, nos conceda permissão."
        }
      ],
      "expo-image",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F243F"
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "eas": {
        "projectId": "67fc0b3a-7600-4ff0-baf7-8b28311de725"
      }
    }
  }
}
